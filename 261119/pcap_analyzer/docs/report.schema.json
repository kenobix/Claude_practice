{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "input",
    "tool",
    "config",
    "complete",
    "summary",
    "classification_indices",
    "flows",
    "dns",
    "diagnostics",
    "unattributed_indices"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3.0"
    },
    "phase": {
      "const": "2a"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes",
        "timestamp_precision",
        "linktype"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_precision": {
          "enum": [
            "us",
            "ns"
          ]
        },
        "linktype": {
          "const": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "pcap-analyzer"
        },
        "version": {
          "const": "0.2.0"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "max_input_bytes",
        "max_records",
        "max_packet_bytes",
        "max_diagnostics",
        "max_flows"
      ],
      "properties": {
        "version": {
          "const": "0.3"
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "max_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_packet_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_diagnostics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_flows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_count",
        "captured_bytes",
        "original_bytes",
        "classification_counts",
        "protocol_counts",
        "parsed_ratio",
        "start_ns",
        "end_ns",
        "duration_ns",
        "ipv4_fragment_count",
        "timestamp_invalid_count",
        "flow_count",
        "unattributed_packet_count",
        "unattributed_captured_bytes",
        "unattributed_original_bytes"
      ],
      "properties": {
        "packet_count": {
          "type": "integer",
          "minimum": 0
        },
        "captured_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "original_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "classification_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parsed",
            "unsupported",
            "truncated",
            "malformed"
          ],
          "properties": {
            "parsed": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "integer",
              "minimum": 0
            },
            "malformed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "protocol_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tcp",
            "udp",
            "ipv4_fragment",
            "ipv4_other",
            "non_ipv4",
            "unknown"
          ],
          "properties": {
            "tcp": {
              "type": "integer",
              "minimum": 0
            },
            "udp": {
              "type": "integer",
              "minimum": 0
            },
            "ipv4_fragment": {
              "type": "integer",
              "minimum": 0
            },
            "ipv4_other": {
              "type": "integer",
              "minimum": 0
            },
            "non_ipv4": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "parsed_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "start_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duration_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ipv4_fragment_count": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "flow_count": {
          "type": "integer",
          "minimum": 0
        },
        "unattributed_packet_count": {
          "type": "integer",
          "minimum": 0
        },
        "unattributed_captured_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "unattributed_original_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "classification_indices": {
      "description": "Exclusive packet classifications, including structure validation of otherwise parsed UDP port-53 candidates. DNS errors do not invalidate verified flow headers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parsed",
        "unsupported",
        "truncated",
        "malformed"
      ],
      "properties": {
        "parsed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "truncated": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "malformed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol",
          "a",
          "b",
          "a_to_b",
          "b_to_a",
          "tcp_flag_counts"
        ],
        "properties": {
          "protocol": {
            "enum": [
              6,
              17
            ]
          },
          "a": {
            "$ref": "#/$defs/endpoint"
          },
          "b": {
            "$ref": "#/$defs/endpoint"
          },
          "a_to_b": {
            "$ref": "#/$defs/direction"
          },
          "b_to_a": {
            "$ref": "#/$defs/direction"
          },
          "tcp_flag_counts": {
            "anyOf": [
              {
                "$ref": "#/$defs/tcp_flags"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "protocol": {
                  "const": 6
                }
              }
            },
            "then": {
              "properties": {
                "tcp_flag_counts": {
                  "$ref": "#/$defs/tcp_flags"
                }
              }
            },
            "else": {
              "properties": {
                "tcp_flag_counts": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "dns": {
      "description": "Query/response matching status only. DNS structure errors are reported through packet classifications and diagnostics; matching remains unimplemented.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "time_analysis",
        "events"
      ],
      "properties": {
        "status": {
          "const": "not_implemented"
        },
        "time_analysis": {
          "enum": [
            "not_implemented",
            "disabled_timestamp_regression"
          ]
        },
        "events": {
          "type": "null"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "reason",
          "packet_index"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[EPW]_[A-Z_]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "packet_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "unattributed_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCAP analyzer Phase 2a report v0.3.0",
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ip",
        "port"
      ],
      "properties": {
        "ip": {
          "type": "string",
          "format": "ipv4"
        },
        "port": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packets",
        "captured_bytes",
        "original_bytes",
        "packet_indices"
      ],
      "properties": {
        "packets": {
          "type": "integer",
          "minimum": 0
        },
        "captured_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "original_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "packet_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      }
    },
    "tcp_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "F",
        "S",
        "R",
        "P",
        "A",
        "U",
        "E",
        "C",
        "N"
      ],
      "properties": {
        "F": {
          "type": "integer",
          "minimum": 0
        },
        "S": {
          "type": "integer",
          "minimum": 0
        },
        "R": {
          "type": "integer",
          "minimum": 0
        },
        "P": {
          "type": "integer",
          "minimum": 0
        },
        "A": {
          "type": "integer",
          "minimum": 0
        },
        "U": {
          "type": "integer",
          "minimum": 0
        },
        "E": {
          "type": "integer",
          "minimum": 0
        },
        "C": {
          "type": "integer",
          "minimum": 0
        },
        "N": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
