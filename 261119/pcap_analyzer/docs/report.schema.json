{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input",
    "tool",
    "config",
    "complete",
    "summary",
    "flows",
    "dns",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes",
        "timestamp_precision",
        "linktype"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_precision": {
          "enum": [
            "us",
            "ns"
          ]
        },
        "linktype": {
          "const": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "pcap-analyzer"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "dns_window_ns",
        "max_input_bytes",
        "max_records",
        "max_flows",
        "max_dns_keys"
      ],
      "properties": {
        "version": {
          "const": "0.1"
        },
        "dns_window_ns": {
          "type": "integer",
          "minimum": 1
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_records": {
          "type": "integer",
          "minimum": 0
        },
        "max_flows": {
          "type": "integer",
          "minimum": 0
        },
        "max_dns_keys": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_count",
        "captured_bytes",
        "original_bytes",
        "unattributed_captured_bytes",
        "classification_counts",
        "parsed_ratio",
        "start_ns",
        "end_ns",
        "duration_ns",
        "ipv4_fragment_count"
      ],
      "properties": {
        "packet_count": {
          "type": "integer",
          "minimum": 0
        },
        "captured_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "original_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "unattributed_captured_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "classification_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parsed",
            "unsupported",
            "truncated",
            "malformed"
          ],
          "properties": {
            "parsed": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "integer",
              "minimum": 0
            },
            "malformed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "parsed_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "start_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duration_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ipv4_fragment_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol",
          "a",
          "b",
          "a_to_b",
          "b_to_a",
          "tcp_flag_counts"
        ],
        "properties": {
          "protocol": {
            "enum": [
              6,
              17
            ]
          },
          "a": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ip",
              "port"
            ],
            "properties": {
              "ip": {
                "type": "string",
                "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
              },
              "port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            }
          },
          "b": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ip",
              "port"
            ],
            "properties": {
              "ip": {
                "type": "string",
                "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
              },
              "port": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            }
          },
          "a_to_b": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packets",
              "captured_bytes",
              "original_bytes",
              "packet_indices"
            ],
            "properties": {
              "packets": {
                "type": "integer",
                "minimum": 0
              },
              "captured_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "original_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "packet_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "uniqueItems": true
              }
            }
          },
          "b_to_a": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "packets",
              "captured_bytes",
              "original_bytes",
              "packet_indices"
            ],
            "properties": {
              "packets": {
                "type": "integer",
                "minimum": 0
              },
              "captured_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "original_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "packet_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "uniqueItems": true
              }
            }
          },
          "tcp_flag_counts": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "F",
              "S",
              "R",
              "P",
              "A",
              "U",
              "E",
              "C"
            ],
            "properties": {
              "F": {
                "type": "integer",
                "minimum": 0
              },
              "S": {
                "type": "integer",
                "minimum": 0
              },
              "R": {
                "type": "integer",
                "minimum": 0
              },
              "P": {
                "type": "integer",
                "minimum": 0
              },
              "A": {
                "type": "integer",
                "minimum": 0
              },
              "U": {
                "type": "integer",
                "minimum": 0
              },
              "E": {
                "type": "integer",
                "minimum": 0
              },
              "C": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_analysis",
        "events"
      ],
      "properties": {
        "time_analysis": {
          "enum": [
            "enabled",
            "disabled_timestamp_regression"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "query_indices",
              "response_indices",
              "response_time_ms",
              "rcode",
              "tc",
              "key"
            ],
            "properties": {
              "status": {
                "enum": [
                  "matched",
                  "ambiguous",
                  "additional_response",
                  "unmatched_response",
                  "no_response_observed",
                  "window_incomplete"
                ]
              },
              "query_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "uniqueItems": true
              },
              "response_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "uniqueItems": true
              },
              "response_time_ms": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "rcode": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 15
              },
              "tc": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "key": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "client",
                  "server",
                  "id",
                  "labels_hex",
                  "qtype",
                  "qclass"
                ],
                "properties": {
                  "client": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ip",
                      "port"
                    ],
                    "properties": {
                      "ip": {
                        "type": "string",
                        "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      }
                    }
                  },
                  "server": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ip",
                      "port"
                    ],
                    "properties": {
                      "ip": {
                        "type": "string",
                        "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535
                      }
                    }
                  },
                  "id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "labels_hex": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^(?:[0-9a-f]{2})*$"
                    }
                  },
                  "qtype": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "qclass": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "matched"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "query_indices": {
                      "minItems": 1,
                      "maxItems": 1
                    },
                    "response_indices": {
                      "minItems": 1,
                      "maxItems": 1
                    },
                    "response_time_ms": {
                      "type": "number"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "response_time_ms": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "packet_index",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "packet_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCAP analyzer report v0.1.0 (Phase 0 contract)"
}
