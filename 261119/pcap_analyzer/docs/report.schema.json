{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase",
    "input",
    "tool",
    "config",
    "complete",
    "summary",
    "classification_indices",
    "flows",
    "dns",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "phase": {
      "const": 1
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size_bytes",
        "timestamp_precision",
        "linktype"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_precision": {
          "enum": [
            "us",
            "ns"
          ]
        },
        "linktype": {
          "const": 1
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "pcap-analyzer"
        },
        "version": {
          "const": "0.1.0"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "max_input_bytes",
        "max_records",
        "max_packet_bytes",
        "max_diagnostics"
      ],
      "properties": {
        "version": {
          "const": "0.2"
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104857600
        },
        "max_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_packet_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_diagnostics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "complete": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_count",
        "captured_bytes",
        "original_bytes",
        "classification_counts",
        "protocol_counts",
        "parsed_ratio",
        "start_ns",
        "end_ns",
        "duration_ns",
        "ipv4_fragment_count",
        "timestamp_invalid_count"
      ],
      "properties": {
        "packet_count": {
          "type": "integer",
          "minimum": 0
        },
        "captured_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "original_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "classification_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parsed",
            "unsupported",
            "truncated",
            "malformed"
          ],
          "properties": {
            "parsed": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported": {
              "type": "integer",
              "minimum": 0
            },
            "truncated": {
              "type": "integer",
              "minimum": 0
            },
            "malformed": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "protocol_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tcp",
            "udp",
            "ipv4_fragment",
            "ipv4_other",
            "non_ipv4",
            "unknown"
          ],
          "properties": {
            "tcp": {
              "type": "integer",
              "minimum": 0
            },
            "udp": {
              "type": "integer",
              "minimum": 0
            },
            "ipv4_fragment": {
              "type": "integer",
              "minimum": 0
            },
            "ipv4_other": {
              "type": "integer",
              "minimum": 0
            },
            "non_ipv4": {
              "type": "integer",
              "minimum": 0
            },
            "unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "parsed_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "start_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "end_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duration_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ipv4_fragment_count": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_invalid_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "classification_indices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parsed",
        "unsupported",
        "truncated",
        "malformed"
      ],
      "properties": {
        "parsed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "truncated": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "malformed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      }
    },
    "flows": {
      "type": "null"
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "time_analysis",
        "events"
      ],
      "properties": {
        "status": {
          "const": "not_implemented"
        },
        "time_analysis": {
          "enum": [
            "not_implemented",
            "disabled_timestamp_regression"
          ]
        },
        "events": {
          "type": "null"
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "reason",
          "packet_index"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[EPW]_[A-Z_]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "packet_index": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCAP analyzer Phase 1 report v0.2.0"
}
